# ==========================================
# Occo AI - Environment Variables Template
# ==========================================
# Instructions for Reviewers: 
# If you are running the system via 'docker-compose up', you DO NOT need to 
# configure these, as Docker handles the internal routing automatically.
# Only duplicate this file, rename it to '.env', and populate the fields 
# if you are running the FastAPI backend manually on your local machine.

# Neo4j Graph Database Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here

# Backend Application Settings
HOST=0.0.0.0
PORT=8000